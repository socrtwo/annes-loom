{
  "name": "QuillLoom",
  "short_name": "QuillLoom",
  "description": "An open-source web site editor with Design, Split and Code views, a complete customizable command library, AI, and WordPress, Weebly, Wix and web template import.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
  "theme_color": "#2E6B5E",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Web page or site",
      "accept": {
        "text/html": [".html", ".htm", ".xhtml", ".shtml", ".dwt", ".lbi"],
        "text/css": [".css"],
        "application/x-httpd-php": [".php"],
        "application/zip": [".zip"],
        "message/rfc822": [".mht", ".mhtml"],
        "application/x-quillloom-site": [".qlsite"]
      }
    }
  ]
}
