{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": { "palette": [ { "slug": "base", "color": "#fbfaf7", "name": "Base" }, { "slug": "contrast", "color": "#1d2b22", "name": "Contrast" }, { "slug": "accent", "color": "#2f7a4f", "name": "Accent" } ] },
    "typography": {
      "fontSizes": [ { "slug": "small", "size": "0.9rem", "name": "Small" }, { "slug": "large", "size": "1.6rem", "name": "Large" } ],
      "fontFamilies": [ { "slug": "body", "name": "Body", "fontFamily": "\"Inter\", sans-serif", "fontFace": [ { "fontFamily": "Inter", "fontWeight": "400", "fontStyle": "normal", "src": [ "file:./assets/fonts/inter.woff2" ] } ] } ]
    },
    "spacing": { "spacingSizes": [ { "slug": "40", "size": "1rem", "name": "1" } ] },
    "layout": { "contentSize": "640px", "wideSize": "1100px" }
  },
  "styles": {
    "color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
    "typography": { "fontFamily": "var:preset|font-family|body" },
    "elements": { "link": { "color": { "text": "var:preset|color|accent" }, ":hover": { "color": { "text": "var:preset|color|contrast" } } }, "h1": { "typography": { "fontSize": "2.4rem" } } },
    "blocks": { "core/site-title": { "typography": { "fontWeight": "700" } } }
  }
}
